Bootstrap: localimage
From: meth-analysis-quarto.sif

%post
    apt-get update -y
    apt-get install -y \
        python3 \
        python3-pip \
        python3-dev \
        python3-venv 
    ln -sf /usr/bin/python3 /usr/bin/python

    python3 -m venv /opt/venv
    . /opt/venv/bin/activate

    pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
        numpy \
	pandas \
	numexpr \
	bottleneck \
	pysam

    cd /opt
    git clone https://github.com/perishky/methylseqextractor.git

    apt-get autoremove -y
    apt-get clean
    rm -rf /var/lib/apt/lists/

%environment
    export PYTHONPATH=$PYTHONPATH:/opt/methylseqextractor
 
%runscript
    . /opt/venv/bin/activate
    exec "$@"


Bootstrap: localimage
From: meth-analysis-python.sif


%post
    ARCHIVE=csvtk_linux_amd64.tar.gz
    wget https://github.com/shenwei356/csvtk/releases/download/v0.36.0/$ARCHIVE
    gunzip -c $ARCHIVE | tar xv
    chmod a+x csvtk
    mv csvtk /usr/local/bin/
    rm $ARCHIVE 

%runscript
    . /opt/venv/bin/activate
    exec "$@"
    
%labels
    Author Matthew Suderman
    Version v1.0
    Description Python 3.12.3, Quarto 1.7.32 and R 4.5.3

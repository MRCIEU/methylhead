Bootstrap: localimage
From: meth-analysis-csvtk.sif

%post
    cd /usr/local/bin
    ln -s /usr/bin/R
    ln -s /usr/bin/Rscript
    ln -s /usr/bin/python
    ln -s /usr/bin/python3
    ln -s /usr/bin/python3-config
    ln -s /usr/bin/pip
    ln -s /usr/bin/pip3

%runscript
    . /opt/venv/bin/activate
    exec "$@"
    
%labels
    Author Matthew Suderman
    Version v1.0
    Description Python 3.12.3, Quarto 1.7.32, R 4.5.3 and csvtk 0.36.0
